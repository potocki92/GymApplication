# Copy this file to `.env.local` and fill in the values from your Supabase project
# (Project Settings → API). The app falls back to local-only IndexedDB when these
# are missing, so it still runs without a backend.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Garmin Connect (Health API, OAuth 2.0 PKCE).
# Server-only — never use the NEXT_PUBLIC_ prefix. Without these the app runs
# in demo mode (deterministic mocked activities, no real Garmin calls).
# REDIRECT_URI must exactly match the value configured in the Garmin
# Connect Developer Portal (Health API → Application settings).
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=http://localhost:3000/api/integrations/garmin/callback
# Optional: force mock client even when the three vars above are set.
# GARMIN_USE_MOCK=true
